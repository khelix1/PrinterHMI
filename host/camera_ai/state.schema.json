{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrinterHMI host camera AI state",
  "type": "object",
  "required": [
    "status",
    "confidence",
    "defect",
    "updated"
  ],
  "properties": {
    "status": {
      "enum": [
        "disabled",
        "offline",
        "normal",
        "check",
        "failure"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "defect": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "const": "host-camera-ai"
    }
  }
}
